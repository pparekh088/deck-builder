# ==== Azure OpenAI (real) ====
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini   # or your deployment
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# ==== OpenAI (fallback non-Azure; optional) ====
OPENAI_API_KEY=

# ==== Feature flags ====
HYBRID_VISION_ENABLED=true
ACCURATE_SOLVER_ENABLED=true
RENDER_MEASURE_ENABLED=true
ARCHETYPE_ALIGNMENT_ENABLED=true
SAFETY_MAP_ENABLED=true

# ==== Redis ====
REDIS_URL=redis://localhost:6379/0

# ==== Frontend ====
VITE_API_BASE=http://localhost:8000

# ==== Headless test mode ====
E2E_HEADLESS=true